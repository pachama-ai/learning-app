# --- OS / editor junk ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Windows writes this next to every file that was downloaded; it is not part of
# the project and must never be committed.
*:Zone.Identifier

# --- IDE / editor ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Secrets / environment ---
# Die echten Zugangsdaten stehen in .env im Projektstamm. Nur die Vorlage
# .env.example ist im Git, und in ihr stehen keine echten Werte.
.env
.env.*
!.env.example
src/config/config.local.php
src/config/database.local.php
src/config/*.local.php

# --- Runtime output, logs, caches ---
*.log
logs/
tmp/
cache/

# Laufende Dienste und fertige Sitzungsdateien: der Dateiname enthaelt eine
# Sitzungs-Kennung und gehoert nicht ins Repository.
*.pid
sess_*

# Sicherungen und Datenbank-Abzuege. Sie enthalten echte Daten und duerfen
# niemals mit hochgeladen werden.
*.bak
*.backup
*.sql.bak
*.sql.gz
*.dump
*_backup/
backups/
backup/
dumps/
*.orig
*.rej

# --- Dependencies (reserved, none installed yet) ---
/vendor/

# --- User uploads ---
/public/uploads/

# Laufzeitdaten der Apache-Instanz: Sitzungen des Anmeldestatus und Protokolle
# gehoeren niemals ins Repository.
deploy/apache/sessions/
deploy/apache/logs/

# Zurueckgeholte alte Doku-Datei: der Inhalt steht in docs/dokumentation.md
docs/migrations.md

# --- Laufzeitdaten ---
# Sicherungen der Datenbank. Sie enthalten E-Mail-Adressen und Passwort-Hashes
# und gehoeren unter keinen Umstaenden ins Repository - auch nicht in ein
# privates. Der Ordner entsteht beim ersten Backup selbst.
storage/backups/
/storage/
