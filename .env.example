# Vorlage fuer die lokale Konfiguration der Lernkartei.
#
# So benutzt du sie:
#   1. Diese Datei als .env in den Projektstamm kopieren:
#        cp .env.example .env
#   2. In .env die Werte eintragen (die Datei liegt neben README.md, also eine
#      Ebene ueber public/ und damit ausserhalb des Web-Roots).
#   3. Nichts weiter tun: src/config/database.php liest die Werte beim Start
#      jeder Anfrage selbst ein.
#
# Wichtig:
#   - .env wird NICHT ins Git aufgenommen (.gitignore). Nur diese Vorlage ist
#     im Git, und in ihr stehen absichtlich keine echten Werte.
#   - Leerzeilen und Zeilen, die mit # beginnen, werden ignoriert.
#   - Werte duerfen in "..." oder '...' stehen; die Zeichen gehoeren dann nicht
#     zum Wert.
#   - Eine schon gesetzte Umgebungsvariable wird nicht ueberschrieben.

# Rechner, auf dem die Datenbank laeuft. Lokal fast immer localhost.
DB_HOST=localhost

# Port der Datenbank. MySQL und MariaDB benutzen normalerweise 3306.
DB_PORT=3306

# Name der Datenbank. Sie wurde von Hand in phpMyAdmin angelegt.
DB_NAME=learning_app

# Benutzer der Datenbank. Bitte einen eigenen Benutzer verwenden, nicht root.
DB_USER=db_user

# Passwort dieses Benutzers.
DB_PASS=bitte_eintragen

# Zeichensatz der Verbindung. utf8mb4 kann alle Zeichen speichern, auch Emoji.
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# E-Mails (die Benachrichtigung "du bist dran" der gemeinsamen Geschichte)
#
# Ohne diese Werte laeuft die Anwendung ganz normal weiter; es wird nur nichts
# verschickt. Welche Adresse wem gehoert, steht in der Tabelle users - hier steht
# nur, WIE verschickt wird.
#
# Auf diesem Server ist kein sendmail installiert, der Versand geht deshalb direkt
# ueber den SMTP-Server des Postfachs. Bei Gmail braucht es dafuer ein
# App-Passwort (Google-Konto -> Sicherheit -> App-Passwoerter), nicht das
# Kontopasswort.
# ---------------------------------------------------------------------------

# Rechner des Postfachs, zum Beispiel smtp.gmail.com
MAIL_HOST=smtp.gmail.com

# Port: 587 fuer STARTTLS, 465 fuer eine von Anfang an verschluesselte Verbindung.
MAIL_PORT=587

# 'tls' (STARTTLS, ab Port 587), 'ssl' (ab Port 465) oder leer (unverschluesselt).
MAIL_SECURE=tls

# Anmeldename des Postfachs, meist die vollstaendige Adresse.
MAIL_USER=bitte_eintragen

# Passwort bzw. App-Passwort dieses Postfachs. Steht nur hier und nie im Code.
MAIL_PASS=bitte_eintragen

# Absenderadresse. Leer heisst: dieselbe wie MAIL_USER.
MAIL_FROM=

# Absendername, den das Mailprogramm anzeigt.
MAIL_FROM_NAME=Lernkartei

# Basisadresse der Anwendung - daraus baut die Benachrichtigung ihren Link.
# Leer heisst: der Link steht ohne Adresse da (nur /story.php).
APP_BASE_URL=https://study.yokunto.de
