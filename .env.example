# Vorlage fuer die lokale Konfiguration der Lernkartei.
#
# So benutzt du sie:
#   1. Diese Datei als .env in den Projektstamm kopieren:
#        cp .env.example .env
#   2. In .env die Werte eintragen (die Datei liegt neben README.md, also eine
#      Ebene ueber public/ und damit ausserhalb des Web-Roots).
#   3. Nichts weiter tun: src/config/database.php liest die Werte beim Start
#      jeder Anfrage selbst ein.
#
# Wichtig:
#   - .env wird NICHT ins Git aufgenommen (.gitignore). Nur diese Vorlage ist
#     im Git, und in ihr stehen absichtlich keine echten Werte.
#   - Leerzeilen und Zeilen, die mit # beginnen, werden ignoriert.
#   - Werte duerfen in "..." oder '...' stehen; die Zeichen gehoeren dann nicht
#     zum Wert.
#   - Eine schon gesetzte Umgebungsvariable wird nicht ueberschrieben.

# Rechner, auf dem die Datenbank laeuft. Lokal fast immer localhost.
DB_HOST=localhost

# Port der Datenbank. MySQL und MariaDB benutzen normalerweise 3306.
DB_PORT=3306

# Name der Datenbank. Sie wurde von Hand in phpMyAdmin angelegt.
DB_NAME=learning_app

# Benutzer der Datenbank. Bitte einen eigenen Benutzer verwenden, nicht root.
DB_USER=db_user

# Passwort dieses Benutzers.
DB_PASS=bitte_eintragen

# Zeichensatz der Verbindung. utf8mb4 kann alle Zeichen speichern, auch Emoji.
DB_CHARSET=utf8mb4
