# Leistungseinstellungen für Apache.
#
# Diese Datei wird vom Entwicklungsserver von PHP ("php -S") ignoriert, mit dem die
# Anwendung lokal meist gestartet wird, dort ändert sich also nichts. Sie wirkt nur,
# wenn Apache DIESEN Ordner als DocumentRoot ausliefert und der Server "AllowOverride"
# dafür eingeschaltet hat.
#
# Nichts hier drin ändert eine Seite, ein Skript, ein Stylesheet oder eine Zeichnung:
# Dateien werden nur auf dem Weg nach draußen komprimiert, und die zwei Sorten Datei, die
# sich während des Betriebs nie ändern, bekommen einen Hinweis für den Browser-Speicher.
# Jeder Block steht in <IfModule>, ein Server ohne dieses Modul ignoriert den Block also,
# statt zu scheitern.
#
# Auf diesem Projekt gemessen, die Zahlen unten sind also echt und keine Schätzung
# (gzip -9, Stand 2026-09-28):
#   app.css       212 KB -> 55 KB
#   app.js        323 KB -> 76 KB
#   die HTML-Seite 111 KB -> 28 KB
#   Browser-Symbol 41 KB -> 10 KB
# WOFF2-Schriften sind schon komprimiert und werden absichtlich nicht angefasst.

<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
        AddOutputFilterByType DEFLATE text/javascript application/javascript
        AddOutputFilterByType DEFLATE application/json application/xml
        AddOutputFilterByType DEFLATE image/svg+xml
    </IfModule>
</IfModule>

# Die Schrift und die Symbole bleiben lange gleich, der Browser darf sie also eine Woche
# behalten. CSS und JavaScript werden absichtlich NICHT so lange gespeichert: sie werden
# bearbeitet, während an der Anwendung gearbeitet wird, und eine halbe Stunde alte Kopie
# wäre verwirrend.
<IfModule mod_expires.c>
    ExpiresActive On

    <FilesMatch "\.(woff2|woff|svg|png|ico)$">
        ExpiresDefault "access plus 7 days"
    </FilesMatch>
</IfModule>

#
# Zugangsdaten und Verzeichnislisten gehoeren nicht ins Netz.
#
# Der DocumentRoot ist public/ - die Datei .env liegt im Projektstamm, also
# schon außerhalb und ist deshalb gar nicht erreichbar. Diese Sperre ist die
# zweite Sicherung, falls public/ einmal versehentlich auf den Projektstamm
# zeigt. Nichts an der Anwendung hängt davon ab, deshalb sind die Regeln
# unschädlich.
#
# Hinweis: Ohne "-Indexes" könnte ein Ordner ohne index.php seinen Inhalt
# auflisten. mod_authz_core ist in Apache 2.4 eingebaut; fehlt es, greift der
# Block nicht und die Anwendung läuft trotzdem.
#
<IfModule mod_authz_core.c>
    <FilesMatch "^\.(env|git|htpasswd|htaccess|DS_Store)">
        Require all denied
    </FilesMatch>
</IfModule>

# Keine Verzeichnisauflistung und keine Verarbeitung von SSI.
Options -Indexes -Includes
