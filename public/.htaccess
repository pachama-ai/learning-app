# Performance settings for Apache.
#
# This file is ignored by PHP's own development server ("php -S"), which is how
# the app is usually started locally, so nothing changes there. It only takes
# effect when Apache serves THIS folder as its DocumentRoot and the server has
# "AllowOverride" enabled for it.
#
# Nothing in here changes a page, a script, a stylesheet or a drawing: files are
# only compressed on the way out, and the two kinds of file that never change
# while the app runs get a browser cache hint. Every block sits inside
# <IfModule>, so a server without that module ignores the block instead of
# failing.
#
# Measured on this project, so the numbers below are real and not estimates:
#   app.css    91 KB -> 23 KB
#   app.js    117 KB -> 27 KB
#   the HTML   31 KB ->  8 KB
#   browser icon 41 KB -> 10 KB
# WOFF2 fonts are compressed already and are deliberately not touched.

<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
        AddOutputFilterByType DEFLATE text/javascript application/javascript
        AddOutputFilterByType DEFLATE application/json application/xml
        AddOutputFilterByType DEFLATE image/svg+xml
    </IfModule>
</IfModule>

# The font and the icons are the same for a long time, so the browser may keep
# them for a week. CSS and JavaScript are deliberately NOT cached that long:
# they are edited while the app is being worked on, and a stale copy that is
# half an hour old would be confusing.
<IfModule mod_expires.c>
    ExpiresActive On

    <FilesMatch "\.(woff2|woff|svg|png|ico)$">
        ExpiresDefault "access plus 7 days"
    </FilesMatch>
</IfModule>

#
# Zugangsdaten und Verzeichnislisten gehoeren nicht ins Netz.
#
# Der DocumentRoot ist public/ - die Datei .env liegt im Projektstamm, also
# schon ausserhalb und ist deshalb gar nicht erreichbar. Diese Sperre ist die
# zweite Sicherung, falls public/ einmal versehentlich auf den Projektstamm
# zeigt. Nichts an der Anwendung haengt davon ab, deshalb sind die Regeln
# unschaedlich.
#
# Hinweis: Ohne "-Indexes" koennte ein Ordner ohne index.php seinen Inhalt
# auflisten. mod_authz_core ist in Apache 2.4 eingebaut; fehlt es, greift der
# Block nicht und die Anwendung laeuft trotzdem.
#
<IfModule mod_authz_core.c>
    <FilesMatch "^\.(env|git|htpasswd|htaccess|DS_Store)">
        Require all denied
    </FilesMatch>
</IfModule>

# Keine Verzeichnisauflistung und keine Verarbeitung von SSI.
Options -Indexes -Includes
